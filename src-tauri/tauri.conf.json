{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDownEditor",
  "version": "0.1.0",
  "identifier": "com.markdowneditor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkDownEditor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.plantuml.com https://plantuml.com http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://www.plantuml.com http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/plantuml.jar"
    ],
    "externalBin": [],
    "fileAssociations": [
      {
        "name": "Markdown Document",
        "description": "Open with MarkDownEditor",
        "ext": ["md", "markdown", "mdx", "txt"],
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/StoreLogo.png"
    ]
  }
}